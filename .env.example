# Local development example — copy to .env (do not commit .env)
DB_URL=jdbc:mysql://127.0.0.1:3306/app?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=app
DB_PASSWORD=your_db_password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://sms.recruit.kayple.com/v1/messages

SESSION_COOKIE_SECURE=false
