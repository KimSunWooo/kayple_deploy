#!/bin/sh
# Minimal Maven Wrapper bootstrap — downloads Apache Maven binary on first run.
set -e
BASE_DIR=$(cd "$(dirname "$0")" && pwd)
MAVEN_VERSION=3.9.9
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
DIST_DIR="$WRAPPER_DIR/apache-maven-$MAVEN_VERSION"
MVN_CMD="$DIST_DIR/bin/mvn"

if [ ! -x "$MVN_CMD" ]; then
  mkdir -p "$WRAPPER_DIR"
  TGZ="$WRAPPER_DIR/apache-maven-$MAVEN_VERSION-bin.tar.gz"
  if [ ! -f "$TGZ" ]; then
    echo "Downloading Apache Maven $MAVEN_VERSION..."
    curl -fsSL "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" -o "$TGZ"
  fi
  tar -xzf "$TGZ" -C "$WRAPPER_DIR"
fi

exec "$MVN_CMD" "$@"
