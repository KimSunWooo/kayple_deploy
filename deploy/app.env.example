# Copy to /etc/kayple/app.env on the server (chmod 600, owner root).
# Fill in real values locally on the server — do not commit secrets.

DB_URL=jdbc:mysql://127.0.0.1:3306/app?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=app
DB_PASSWORD=CHANGE_ME

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

SMS_API_KEY=CHANGE_ME
SMS_API_URL=https://sms.recruit.kayple.com/v1/messages

SESSION_COOKIE_SECURE=true
